{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022"],
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "noEmit": true,
    "jsx": "preserve",
    "types": [
      "https://deno.land/std@0.224.0/fs/mod.ts"
    ]
  },
  "imports": {
    "oak": "https://deno.land/x/oak@v17.1.4/mod.ts",
    "postgres": "https://deno.land/x/postgres@v0.19.3/mod.ts",
    "redis": "https://deno.land/x/redis@v0.32.1/mod.ts",
    "zod": "https://deno.land/x/zod@v3.23.8/mod.ts",
    "dotenv": "https://deno.land/std@0.224.0/dotenv/mod.ts"
  }
}
