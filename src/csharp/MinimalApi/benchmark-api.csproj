<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Native AOT is disabled: Minimal API's request delegates are generated
         by the Request Delegate Generator, which serializes results through
         System.Text.Json's source-generated resolver. With PublishAot=true the
         resolver has no JsonTypeInfo for the anonymous health/error envelopes
         or the JsonResponse/JsonItem types, so EVERY endpoint threw
         "JsonTypeInfo metadata for type '...' was not provided" at runtime and
         the impl scored 0/7. The Controllers and FastEndpoints siblings ship
         with PublishAot=false for the same reason; this matches them. -->
    <PublishAot>false</PublishAot>

    <!-- Docker/Container Settings -->
    <ContainerPort>8080</ContainerPort>
  </PropertyGroup>

  <ItemGroup>
    <!-- Database -->
    <PackageReference Include="Npgsql" Version="9.0.0" />

    <!-- Redis -->
    <PackageReference Include="StackExchange.Redis" Version="2.7.33" />

    <!-- Configuration -->
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.0" />

    <!-- Logging -->
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.0" />

    <!-- Health Checks -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="9.0.0" />

    <!-- Metrics -->
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
