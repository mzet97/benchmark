{
  "name": "benchmark-nodejs-fastify",
  "version": "1.0.0",
  "description": "High-performance REST API benchmark - Node.js Fastify",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "build": "echo 'No build step required for Node.js'",
    "test": "node --test src/**/*.test.js",
    "lint": "eslint src/**/*.js",
    "format": "prettier --write src/**/*.js"
  },
  "keywords": [
    "benchmark",
    "fastify",
    "nodejs",
    "api",
    "rest"
  ],
  "author": "Benchmark Team",
  "license": "MIT",
  "dependencies": {
    "fastify": "^4.28.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/sensible": "^5.6.0",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^5.1.0",
    "@fastify/under-pressure": "^8.3.0",
    "@fastify/schedule": "^8.1.0",
    "fastify-plugin": "^4.5.1",
    "fastify-type-provider-zod": "^3.0.0",
    "zod": "^3.23.8",
    "pg": "^8.12.0",
    "redis": "^4.7.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "eslint": "^9.10.0",
    "prettier": "^3.3.3",
    "pino-pretty": "^11.2.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
